# Copy to infra/compose/.env on the server. Never commit the real file (§54).
APP_ENV=production            # or staging
DOMAIN=eduplay.example
ACME_EMAIL=ops@eduplay.example
TAG=latest
REGISTRY=ghcr.io/setiyoaryo

POSTGRES_USER=eduplay
POSTGRES_PASSWORD=change-me
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Payment: "midtrans" (default) or "mock" (staging/testing).
PAYMENT_PROVIDER=midtrans
PAYMENT_SECRET=test-payment-secret
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=true
MONTHLY_PRICE_IDR=49000

# Storage: "s3" (default) or "local" (staging/testing without S3).
STORAGE_DRIVER=s3
S3_ENDPOINT=                  # host only, e.g. <account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=eduplay-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
BACKUP_RETENTION_DAYS=14
GRAFANA_ADMIN_PASSWORD=change-me
