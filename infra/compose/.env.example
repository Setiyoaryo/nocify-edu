# Copy to infra/compose/.env on the server. Never commit the real file (§54).
APP_ENV=production            # or staging
DOMAIN=eduplay.example
ACME_EMAIL=ops@eduplay.example
TAG=latest
REGISTRY=ghcr.io/nocify

POSTGRES_USER=eduplay
POSTGRES_PASSWORD=change-me
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Midtrans (dashboard → Settings → Access Keys). Staging: sandbox key + MIDTRANS_PRODUCTION=false.
# Set the Payment Notification URL in the Midtrans dashboard to https://$DOMAIN/api/v1/webhooks/payment
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=true
MONTHLY_PRICE_IDR=49000

# S3-compatible object storage (AWS S3, Cloudflare R2, IDCloudHost, …). Bucket stays private.
S3_ENDPOINT=                  # host only, e.g. <account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=eduplay-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

BACKUP_RETENTION_DAYS=14
GRAFANA_ADMIN_PASSWORD=change-me
