# Content pipeline (development). Copy to .env or export before running.
# The pipeline connects with a role that can only write to content_staging.

DATABASE_URL=postgres://eduplay:eduplay@localhost:55433/eduplay?sslmode=disable

# Crawl politeness / safety
PIPELINE_USER_AGENT=NocifyEduPlayBot/0.1 (+https://github.com/Setiyoaryo/nocify-edu)
HTTP_TIMEOUT_SECONDS=20
MAX_RESPONSE_BYTES=10485760
MAX_REDIRECTS=5
DEFAULT_RATE_LIMIT_MS=1000

# Raw archive (optional). Leave S3_BUCKET empty to disable archiving.
S3_ENDPOINT=localhost:8333
S3_REGION=us-east-1
S3_BUCKET=eduplay-dev
S3_USE_SSL=false
STORAGE_ACCESS_KEY=eduplay
STORAGE_SECRET_KEY=eduplay-dev-secret
