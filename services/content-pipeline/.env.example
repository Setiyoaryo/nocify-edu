# Content pipeline (development). Copy to .env or export before running.
# The pipeline connects with a role that can only write to content_staging.

DATABASE_URL=postgres://eduplay:eduplay@localhost:55433/eduplay?sslmode=disable

# Crawl politeness / safety
PIPELINE_USER_AGENT=NocifyEduPlayBot/0.1 (+https://github.com/Setiyoaryo/nocify-edu)
HTTP_TIMEOUT_SECONDS=20
MAX_RESPONSE_BYTES=10485760
MAX_REDIRECTS=5
DEFAULT_RATE_LIMIT_MS=1000

# Raw archive (optional). Leave S3_BUCKET empty to disable archiving.
S3_ENDPOINT=localhost:8333
S3_REGION=us-east-1
S3_BUCKET=eduplay-dev
S3_USE_SSL=false
STORAGE_ACCESS_KEY=eduplay
STORAGE_SECRET_KEY=eduplay-dev-secret

# AI provider (M6). Leave AI_PROVIDER empty to disable every AI-backed command
# (embed / map --semantic / generate). Use "mock" for offline dev and tests: it
# is deterministic and needs no key. "openai" is any OpenAI-compatible endpoint
# and requires AI_BASE_URL + AI_API_KEY. Never commit real keys.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_EMBEDDING_MODEL=
AI_CHAT_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=700
AI_GENERATION_CAP=50
AI_EMBEDDING_BATCH_SIZE=64
AI_PROMPT_VERSION=scenario-v1

# Shared figure vocabulary (M10). Optional: the loader walks up from the package
# to find packages/figures/figures.json. Set FIGURES_PATH only to override it.
FIGURES_PATH=

# Worker daemon (M11). The worker claims jobs the admin UI enqueues and crawls
# active sources on their schedule. POLL is how often an idle worker looks for a
# job; SCHEDULER is how often it checks which sources are due.
PIPELINE_WORKER_POLL_SECONDS=5
PIPELINE_SCHEDULER_SECONDS=60
